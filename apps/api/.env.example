APP_NAME=BrainSprint
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8008
LOG_CHANNEL=single
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=55432
DB_DATABASE=brainsprint
DB_USERNAME=replace_with_local_username
DB_PASSWORD=replace_with_generated_password
SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=true
SESSION_COOKIE=brainsprint_session
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync

# Admin session cookie/name/path/table and 120-minute lifetime are isolated in SessionBoundary.
# Admin and consumer cookies inherit SESSION_SECURE_COOKIE; enable it with HTTPS at release.
# No administrator credentials belong in this file. Use php artisan admin:local locally.

# Release only: same private value on Vercel and Railway, never NEXT_PUBLIC_.
CONSUMER_PROXY_SECRET=
CONSUMER_REQUESTS_PER_MINUTE=60
ANALYTICS_REQUESTS_PER_MINUTE=40
CONSUMER_GLOBAL_REQUESTS_PER_MINUTE=600
TRUSTED_PROXIES=
