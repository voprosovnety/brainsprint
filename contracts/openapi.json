{
  "openapi": "3.1.0",
  "info": {
    "title": "BrainSprint consumer API",
    "version": "3.0.0",
    "description": "Same-origin database-backed anonymous Laravel session; private/no-store. One pinned schema-3 run per session, direct quiz entry, a private illustrative sample report, simulated unlock and guide branches. Unsupported saved runs require session-owned deletion before restart."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3000"
    }
  ],
  "paths": {
    "/api/v1/bootstrap": {
      "get": {
        "operationId": "bootstrap",
        "parameters": [
          {
            "name": "utm_source",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 120
            },
            "description": "First-touch campaign value; ignored after session initialization."
          },
          {
            "name": "utm_medium",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 120
            },
            "description": "First-touch campaign value; ignored after session initialization."
          },
          {
            "name": "utm_campaign",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 120
            },
            "description": "First-touch campaign value; ignored after session initialization."
          },
          {
            "name": "utm_content",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 120
            },
            "description": "First-touch campaign value; ignored after session initialization."
          },
          {
            "name": "utm_term",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 120
            },
            "description": "First-touch campaign value; ignored after session initialization."
          }
        ],
        "responses": {
          "200": {
            "description": "Canonical confirmed state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Bootstrap"
                }
              }
            }
          },
          "404": {
            "description": "Run unavailable to this anonymous session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflicting answer or transition",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "419": {
            "description": "CSRF token missing or expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid answer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Session request limit reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "State could not be saved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Service temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "description": "Restore an owned supported run and its pinned configuration, otherwise use the latest published schema-3 configuration. Direct quiz entry; experiment is null; first-touch UTM is preserved. Unsupported saved runs return restart_required:true and run:null, without old content. No exposure is recorded."
      }
    },
    "/api/v1/runs": {
      "post": {
        "operationId": "startOrResume",
        "parameters": [
          {
            "name": "X-XSRF-TOKEN",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "URL-decoded XSRF-TOKEN cookie from bootstrap"
          }
        ],
        "responses": {
          "200": {
            "description": "Canonical confirmed state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            }
          },
          "404": {
            "description": "Run unavailable to this anonymous session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflicting answer or transition",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "419": {
            "description": "CSRF token missing or expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid answer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Session request limit reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "State could not be saved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Service temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Write origin is not the frontend origin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "Owned saved run is no longer supported (run_retired). Delete its data from the home screen before starting the current challenge. Foreign IDs remain 404.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "attribution": {
                    "$ref": "#/components/schemas/Attribution"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
    "/api/v1/runs/{run}": {
      "get": {
        "operationId": "readRun",
        "parameters": [
          {
            "name": "run",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Canonical confirmed state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            }
          },
          "404": {
            "description": "Run unavailable to this anonymous session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflicting answer or transition",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "419": {
            "description": "CSRF token missing or expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid answer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Session request limit reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "State could not be saved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Service temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "Owned saved run is no longer supported (run_retired). Delete its data from the home screen before starting the current challenge. Foreign IDs remain 404.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/runs/{run}/steps/{step}/complete": {
      "post": {
        "operationId": "completeStep",
        "parameters": [
          {
            "name": "run",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "step",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,39}$"
            }
          },
          {
            "name": "X-XSRF-TOKEN",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "URL-decoded XSRF-TOKEN cookie from bootstrap"
          }
        ],
        "responses": {
          "200": {
            "description": "Canonical confirmed state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            }
          },
          "404": {
            "description": "Run unavailable to this anonymous session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflicting answer or transition",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "419": {
            "description": "CSRF token missing or expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid answer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Session request limit reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "State could not be saved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Service temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Write origin is not the frontend origin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "Owned saved run is no longer supported (run_retired). Delete its data from the home screen before starting the current challenge. Foreign IDs remain 404.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Completion"
              }
            }
          }
        },
        "description": "Validate and atomically persist the pinned answer, transition and deduplicated milestones. Confirm a private sample report once, expose only teaser before mock unlock, persist deadline/unlock/guide choice, and complete the selected final. Identical retries restore confirmed state. No financial data accepted. See V3.md."
      }
    },
    "/api/v1/events": {
      "post": {
        "operationId": "recordClientExposure",
        "summary": "Record an actual visible screen exposure",
        "description": "CSRF protected; max 4096 bytes; independent 40/minute session limit. Retry with the same UUID. Only actual owned screen views are accepted. Deduplication uses visitor/UUID and event name/run/screen. Accepted duplicate IDs are no-ops, including IDs reused for another screen. Server context overrides and milestones are forbidden.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ClientEvent"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted or already recorded",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accepted": {
                      "const": true
                    }
                  },
                  "required": [
                    "accepted"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "404": {
            "description": "Run unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Screen unavailable in confirmed progress",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Event too large",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "419": {
            "description": "CSRF missing or expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid event",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Analytics rate limited",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "Owned saved run is no longer supported (run_retired). Delete its data from the home screen before starting the current challenge. Foreign IDs remain 404.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/demo-analytics": {
      "get": {
        "operationId": "demoAnalytics",
        "summary": "Synthetic aggregate sample for the last seven days",
        "description": "Hard-coded synthetic dataset, rolling [now-7 days,now) UTC cohort, asOf=now, 24-hour observation. All query parameters are rejected (422). No raw IDs, answers, attribution, admin details, or real data. Private/no-store even though aggregate-only. Uses the shared AggregateService and definitions in docs/ANALYTICS.md.",
        "responses": {
          "200": {
            "description": "Aggregate-only illustrative sample; zero denominators have null rates",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "const": "private, no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DemoAnalytics"
                }
              }
            }
          },
          "422": {
            "description": "Query parameters are unsupported",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Consumer rate budget exceeded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Service temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/privacy/delete": {
      "post": {
        "summary": "Permanently delete the current anonymous visitor data and rotate its session",
        "description": "Session ownership only; CSRF protected. Deletes the owned run, answers/result and associated events, including unsupported saved runs and unlinked visitor events. Rotates anonymous session/CSRF cookies. Preserves administrators and other visitors. Exactly an empty JSON object, no query parameters.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "additionalProperties": false,
                "maxProperties": 0
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Deleted; a fresh anonymous session cookie and CSRF token are returned",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "deleted"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "deleted": {
                      "type": "boolean",
                      "const": true
                    }
                  }
                }
              }
            }
          },
          "419": {
            "description": "CSRF token missing or expired"
          },
          "422": {
            "description": "Unexpected body or query"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Configuration": {
        "$ref": "#/components/schemas/V3Configuration"
      },
      "Bootstrap": {
        "type": "object",
        "properties": {
          "configuration_version": {
            "type": "string"
          },
          "configuration": {
            "$ref": "#/components/schemas/Configuration"
          },
          "run": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Run"
              },
              {
                "type": "null"
              }
            ]
          },
          "experiment": {
            "type": "null"
          },
          "restart_required": {
            "type": "boolean",
            "description": "An owned unsupported run exists. No old configuration, answers or result are returned. Delete session-owned data before starting the current challenge."
          }
        },
        "required": [
          "configuration_version",
          "configuration",
          "run",
          "experiment",
          "restart_required"
        ],
        "additionalProperties": false
      },
      "Completion": {
        "type": "object",
        "properties": {
          "answer": {
            "$ref": "#/components/schemas/V3Answer"
          }
        },
        "required": [
          "answer"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "fields": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "Attribution": {
        "type": "object",
        "properties": {
          "utm_source": {
            "type": "string",
            "maxLength": 120,
            "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
          },
          "utm_medium": {
            "type": "string",
            "maxLength": 120,
            "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
          },
          "utm_campaign": {
            "type": "string",
            "maxLength": 120,
            "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
          },
          "utm_content": {
            "type": "string",
            "maxLength": 120,
            "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
          },
          "utm_term": {
            "type": "string",
            "maxLength": 120,
            "pattern": "^[^\\u0000-\\u001F\\u007F]*$"
          }
        },
        "additionalProperties": false
      },
      "ClientEvent": {
        "type": "object",
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "enum": [
              "step_viewed",
              "paywall_viewed_v3",
              "checkout_viewed_v3",
              "report_viewed_v3"
            ]
          },
          "run_id": {
            "type": "string",
            "format": "uuid"
          },
          "step_id": {
            "type": "string",
            "maxLength": 40
          },
          "properties": {
            "type": "object",
            "properties": {
              "surface": {
                "type": "string",
                "enum": [
                  "page"
                ]
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "event_id",
          "name",
          "run_id",
          "step_id"
        ],
        "additionalProperties": false,
        "description": "Requires an owned current or completed screen. Paywall and checkout exposures match paywall; report exposure requires an unlocked final screen. Name/run/screen form semantic identity. Server derives all context and timestamps. No answers, email or financial fields."
      },
      "DemoAnalytics": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dataset",
          "cohort",
          "totals",
          "stage_conversions",
          "quiz_elapsed_seconds"
        ],
        "properties": {
          "dataset": {
            "const": "synthetic"
          },
          "cohort": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to_exclusive",
              "as_of",
              "observation_hours"
            ],
            "properties": {
              "from": {
                "type": "string",
                "format": "date-time"
              },
              "to_exclusive": {
                "type": "string",
                "format": "date-time"
              },
              "as_of": {
                "type": "string",
                "format": "date-time"
              },
              "observation_hours": {
                "const": 24
              }
            }
          },
          "totals": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "runs",
              "funnel_started",
              "quiz_confirmed_v3",
              "processing_completed_v3",
              "paywall_viewed_v3",
              "checkout_viewed_v3",
              "mock_unlocked_v3",
              "upsell_decided_v3",
              "report_viewed_v3",
              "funnel_completed_v3"
            ],
            "properties": {
              "runs": {
                "type": "integer",
                "minimum": 0
              },
              "funnel_started": {
                "type": "integer",
                "minimum": 0
              },
              "quiz_confirmed_v3": {
                "type": "integer",
                "minimum": 0
              },
              "processing_completed_v3": {
                "type": "integer",
                "minimum": 0
              },
              "paywall_viewed_v3": {
                "type": "integer",
                "minimum": 0
              },
              "checkout_viewed_v3": {
                "type": "integer",
                "minimum": 0
              },
              "mock_unlocked_v3": {
                "type": "integer",
                "minimum": 0
              },
              "upsell_decided_v3": {
