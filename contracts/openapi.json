{
  "openapi": "3.1.0",
  "info": {
    "title": "BrainSprint consumer API",
    "version": "2.0.0",
    "description": "Same-origin database-backed anonymous Laravel session; private/no-store. One pinned run per session. Configured progression with tutorial branch, six challenges, persisted illustrative snapshot and terminal demo completion. Historical Memory-only versions remain supported."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3000"
    }
  ],
  "paths": {
    "/api/v1/bootstrap": {
      "get": {
        "operationId": "bootstrap",
        "parameters": [],
        "responses": {
          "200": {
            "description": "Canonical confirmed state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Bootstrap"
                }
              }
            }
          },
          "404": {
            "description": "Run unavailable to this anonymous session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflicting answer or transition",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "419": {
            "description": "CSRF token missing or expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid answer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Session request limit reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "State could not be saved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Service temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/runs": {
      "post": {
        "operationId": "startOrResume",
        "parameters": [
          {
            "name": "X-XSRF-TOKEN",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "URL-decoded XSRF-TOKEN cookie from bootstrap"
          }
        ],
        "responses": {
          "200": {
            "description": "Canonical confirmed state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            }
          },
          "404": {
            "description": "Run unavailable to this anonymous session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflicting answer or transition",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "419": {
            "description": "CSRF token missing or expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid answer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Session request limit reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "State could not be saved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Service temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Write origin is not the frontend origin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/runs/{run}": {
      "get": {
        "operationId": "readRun",
        "parameters": [
          {
            "name": "run",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Canonical confirmed state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            }
          },
          "404": {
            "description": "Run unavailable to this anonymous session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflicting answer or transition",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "419": {
            "description": "CSRF token missing or expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid answer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Session request limit reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "State could not be saved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Service temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/runs/{run}/steps/{step}/complete": {
      "post": {
        "operationId": "completeStep",
        "parameters": [
          {
            "name": "run",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "step",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,39}$"
            }
          },
          {
            "name": "X-XSRF-TOKEN",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "URL-decoded XSRF-TOKEN cookie from bootstrap"
          }
        ],
        "responses": {
          "200": {
            "description": "Canonical confirmed state",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Run"
                }
              }
            }
          },
          "404": {
            "description": "Run unavailable to this anonymous session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Conflicting answer or transition",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "419": {
            "description": "CSRF token missing or expired",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid answer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Session request limit reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "State could not be saved",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Service temporarily unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Write origin is not the frontend origin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Completion"
              }
            }
          }
        },
        "description": "Validate a response against the pinned screen, save the answer and milestones atomically, and advance by server transition rules. Same canonical response is idempotent, even on an old completed screen; a different response returns 409. Wrong owner returns 404. Entering result emits quiz_completed once; acknowledging boundary emits demo_completed once. Exposures are not emitted here."
      }
    }
  },
  "components": {
    "schemas": {
      "MemoryStep": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,39}$"
          },
          "type": {
            "enum": [
              "visual_memory",
              "explanation"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 600
          },
          "enabled": {
            "type": "boolean"
          },
          "variant": {
            "enum": [
              "standard",
              "spotlight"
            ]
          },
          "next": {
            "type": "string"
          },
          "grid_size": {
            "type": "integer",
            "minimum": 3,
            "maximum": 4
          },
          "pattern": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 15
            },
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true
          },
          "reveal_seconds": {
            "type": "integer",
            "minimum": 2,
            "maximum": 15
          }
        },
        "required": [
          "id",
          "type",
          "title",
          "description",
          "enabled",
          "variant",
          "next",
          "grid_size",
          "pattern",
          "reveal_seconds"
        ],
        "additionalProperties": false
      },
      "Configuration": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/FunnelConfiguration"
          },
          {
            "$ref": "#/components/schemas/LegacyConfiguration"
          }
        ]
      },
      "Result": {
        "type": "object",
        "properties": {
          "kind": {
            "const": "illustrative_demo"
          },
          "disclaimer": {
            "type": "string"
          },
          "indicators": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string"
                },
                "value": {
                  "type": "integer",
                  "minimum": 60,
                  "maximum": 95
                }
              },
              "required": [
                "label",
                "value"
              ],
              "additionalProperties": false
            },
            "minItems": 3,
            "maxItems": 3
          }
        },
        "required": [
          "kind",
          "disclaimer",
          "indicators"
        ],
        "additionalProperties": false
      },
      "Run": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "configuration_version": {
            "type": "string"
          },
          "configuration": {
            "$ref": "#/components/schemas/Configuration"
          },
          "current_step": {
            "type": "string",
            "description": "Canonical screen ID or done. Historical T1 result is terminal without a boundary."
          },
          "completed_steps": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 0,
            "maxItems": 24,
            "uniqueItems": true
          },
          "result": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Result"
              },
              {
                "type": "null"
              }
            ]
          },
          "answers": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/Answer"
            },
            "description": "Owner-only canonical saved responses, keyed by completed screen ID."
          },
          "demo_completed": {
            "type": "boolean",
            "description": "True only after a v2 boundary acknowledgement. Historical T1 result remains a completed memory preview."
          }
        },
        "required": [
          "id",
          "configuration_version",
          "configuration",
          "current_step",
          "completed_steps",
          "result",
          "answers",
          "demo_completed"
        ],
        "additionalProperties": false
      },
      "Bootstrap": {
        "type": "object",
        "properties": {
          "configuration_version": {
            "type": "string"
          },
          "configuration": {
            "$ref": "#/components/schemas/Configuration"
          },
          "run": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Run"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "configuration_version",
          "configuration",
          "run"
        ],
        "additionalProperties": false
      },
      "Completion": {
        "type": "object",
        "properties": {
          "answer": {
            "$ref": "#/components/schemas/Answer"
          }
        },
        "required": [
          "answer"
        ],
        "additionalProperties": false
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              },
              "fields": {
                "type": "object",
                "additionalProperties": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            },
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "error"
        ],
        "additionalProperties": false
      },
      "LegacyMemoryStep": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "const": "memory"
          },
          "type": {
            "const": "visual_memory"
          },
          "title": {
            "type": "string"
          },
          "grid_size": {
            "const": 4
          },
          "pattern": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 15
            },
            "uniqueItems": true
          },
          "reveal_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 30
          }
        },
        "required": [
          "id",
          "type",
          "title",
          "grid_size",
          "pattern",
          "reveal_seconds"
        ],
        "additionalProperties": false
      },
      "LegacyConfiguration": {
        "type": "object",
        "properties": {
          "landing": {
            "type": "object",
            "properties": {
              "eyebrow": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "cta": {
                "type": "string"
              }
            },
            "required": [
              "eyebrow",
              "title",
              "description",
              "cta"
            ],
            "additionalProperties": false
          },
          "steps": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/LegacyMemoryStep"
            },
            "minItems": 1,
            "maxItems": 1
          },
          "result": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              },
              "disclaimer": {
                "type": "string"
              }
            },
            "required": [
              "title",
              "disclaimer"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "landing",
          "steps",
          "result"
        ],
        "additionalProperties": false
      },
      "TutorialStep": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,39}$"
          },
          "type": {
            "enum": [
              "tutorial"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 600
          },
          "enabled": {
            "type": "boolean"
          },
          "variant": {
            "enum": [
              "standard",
              "spotlight"
            ]
          },
          "next": {
            "type": "string"
          },
          "grid_size": {
            "type": "integer",
            "minimum": 3,
            "maximum": 4
          },
          "pattern": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 15
            },
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true
          },
          "reveal_seconds": {
            "type": "integer",
            "minimum": 2,
            "maximum": 15
          },
          "branch": {
            "type": "object",
            "properties": {
              "incorrect": {
                "type": "string"
              }
            },
            "required": [
              "incorrect"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "type",
          "title",
          "description",
          "enabled",
          "variant",
          "next",
          "grid_size",
          "pattern",
          "reveal_seconds",
          "branch"
        ],
        "additionalProperties": false
      },
      "Tile": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "maxLength": 30
          },
          "symbol": {
            "type": "string",
            "maxLength": 12
          },
          "label": {
            "type": "string",
            "maxLength": 60
          }
        },
        "required": [
          "id",
          "symbol",
          "label"
        ],
        "additionalProperties": false
      },
      "PatternStep": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,39}$"
          },
          "type": {
            "enum": [
              "pattern"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 600
          },
          "enabled": {
            "type": "boolean"
          },
          "variant": {
            "enum": [
              "standard",
              "spotlight"
            ]
          },
          "next": {
            "type": "string"
          },
          "sequence": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 12
            },
            "minItems": 3,
            "maxItems": 6
          },
          "options": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Tile"
            },
            "minItems": 2,
            "maxItems": 4
          },
          "correct_choice": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "title",
          "description",
          "enabled",
          "variant",
          "next",
          "sequence",
          "options",
          "correct_choice"
        ],
        "additionalProperties": false
      },
      "LogicStep": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,39}$"
          },
          "type": {
            "enum": [
              "logic"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 600
          },
          "enabled": {
            "type": "boolean"
          },
          "variant": {
            "enum": [
              "standard",
              "spotlight"
            ]
          },
          "next": {
            "type": "string"
          },
          "cards": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Tile"
            },
            "minItems": 3,
            "maxItems": 5
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 180
            },
            "minItems": 1,
            "maxItems": 4
          },
          "correct_order": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 3,
            "maxItems": 5,
            "uniqueItems": true
          }
        },
        "required": [
          "id",
          "type",
          "title",
          "description",
          "enabled",
          "variant",
          "next",
          "cards",
          "rules",
          "correct_order"
        ],
        "additionalProperties": false
      },
      "ContentStep": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_-]{0,39}$"
          },
          "type": {
            "enum": [
              "onboarding",
              "result",
              "boundary"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 600
          },
          "enabled": {
            "type": "boolean"
          },
          "variant": {
            "enum": [
              "standard",
              "spotlight"
            ]
          },
          "next": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "type",
          "title",
          "description",
          "enabled",
          "variant",
          "next"
        ],
        "additionalProperties": false
      },
      "Screen": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/MemoryStep"
          },
          {
            "$ref": "#/components/schemas/TutorialStep"
          },
          {
            "$ref": "#/components/schemas/PatternStep"
          },
          {
            "$ref": "#/components/schemas/LogicStep"
          },
          {
            "$ref": "#/components/schemas/ContentStep"
          }
        ]
      },
      "FunnelConfiguration": {
        "type": "object",
        "properties": {
          "schema_version": {
            "const": 2
          },
          "entry": {
            "type": "string"
          },
          "landing": {
            "type": "object",
            "properties": {
