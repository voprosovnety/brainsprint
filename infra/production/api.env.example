APP_NAME=BrainSprint
APP_ENV=production
APP_DEBUG=false
APP_KEY=replace_with_generated_laravel_key
APP_URL=https://replace-backend.up.railway.app
LOG_CHANNEL=stderr
DB_CONNECTION=pgsql
DB_HOST=replace_with_private_postgres_host
DB_PORT=5432
DB_DATABASE=replace_with_database
DB_USERNAME=replace_with_database_user
DB_PASSWORD=replace_with_database_secret
SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=true
SESSION_COOKIE=brainsprint_session
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=file
QUEUE_CONNECTION=sync
CONSUMER_PROXY_SECRET=replace_with_random_secret_at_least_32_bytes
CONSUMER_REQUESTS_PER_MINUTE=60
ANALYTICS_REQUESTS_PER_MINUTE=40
CONSUMER_GLOBAL_REQUESTS_PER_MINUTE=600
# Optional: comma-separated verified ingress proxy CIDRs; only forwarded scheme is trusted.
TRUSTED_PROXIES=
PORT=8080
